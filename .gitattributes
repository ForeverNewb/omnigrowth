# Cross-platform consistency — LF everywhere
* text=auto eol=lf

# Binary assets — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.svg    text eol=lf
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.mp4    binary
*.webm   binary
*.mp3    binary
*.wav    binary
*.pdf    binary
*.zip    binary

# Lockfiles — keep stable diffs
pnpm-lock.yaml linguist-generated=true -diff
