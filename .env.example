# =============================================================
# OmniGrowth — environment variables
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored.
#
# v1 SCOPE NOTE — none of these are required to run `pnpm dev`
# today. Auth is a dummy stub and no real backend calls are wired.
# Fill them in as we wire each integration.
# =============================================================


# -------------------------------------------------------------
# Convex — database, realtime, scheduled functions, Convex Auth
# https://dashboard.convex.dev
# Needed: required (auth lives here).
#
# Convex Auth uses JWT_PRIVATE_KEY + JWKS + SITE_URL on the
# CONVEX SIDE, NOT here in .env.local. Push them with:
#
#   pnpm exec generate-auth-keys > /tmp/keys.env
#   pnpm dlx convex env set --from-file /tmp/keys.env --force
#   pnpm dlx convex env set SITE_URL http://localhost:3000
#
# (the generator script lives at scripts/generate-auth-keys.mjs)
# -------------------------------------------------------------

# Set automatically by `pnpm dlx convex dev` — points at your dev deployment.
CONVEX_DEPLOYMENT=

# Public URL the browser uses to reach Convex (read by Next.js).
NEXT_PUBLIC_CONVEX_URL=

# Convex's HTTP actions origin — used for OAuth callbacks and Auth routes.
# Local dev: http://127.0.0.1:3211. Cloud dev/prod: copy from `convex dev` output.
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211


# -------------------------------------------------------------
# OpenRouter — single gateway for all LLM + TTS calls
# https://openrouter.ai/keys
# Needed: for the AI post generator, brand-voice agents, video
# pipeline script + narration. Wraps Claude, GPT, Gemini, Llama,
# Mistral, plus Gemini 3.1 TTS.
# -------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional — what OpenRouter shows on its analytics dashboard.
OPENROUTER_APP_NAME=OmniGrowth
OPENROUTER_APP_URL=https://omnigrowth.app


# -------------------------------------------------------------
# postforme.dev — mediated social posting + OAuth for connected
# accounts (X, LinkedIn, Instagram, Facebook, TikTok, YouTube
# Shorts, Threads, Pinterest).
# https://postforme.dev/dashboard
# Needed: for `connected-accounts` and `calendar` (publishing).
# -------------------------------------------------------------
POSTFORME_API_KEY=
POSTFORME_WEBHOOK_SECRET=


# -------------------------------------------------------------
# Resend — transactional email + sign-in OTP delivery
# https://resend.com/api-keys
# Needed: required for the production sign-in flow (8-digit OTP via
# email) AND for future notifications (post failed, render done,
# OmniBits low, account token expired).
#
# IMPORTANT: the OTP send happens on the Convex side, so these vars
# must be pushed to your Convex deployment as well — not just here:
#
#   pnpm dlx convex env set RESEND_API_KEY <your-key>
#   pnpm dlx convex env set RESEND_FROM_EMAIL "OmniGrowth <noreply@yourdomain.com>"
#
# This .env.local copy is for any Next.js-side email work (e.g.
# transactional sends from server actions later).
# -------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@omnigrowth.app


# -------------------------------------------------------------
# Dev login (password) — escape hatch for E2E + multi-account dev
# Set to "true" only in dev/staging. Production must leave this
# unset (or "false") so /dev-login returns 404.
# -------------------------------------------------------------
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false


# -------------------------------------------------------------
# PostHog — product analytics (free tier OK for v1)
# https://app.posthog.com/project/settings
# Needed: for usage telemetry. Optional in dev.
# -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# -------------------------------------------------------------
# Cloudflare R2 — media / blob storage (S3-compatible + free
# egress + global CDN). Storage layer for premade clips, AI image
# / video output, user uploads, brand logos.
# https://dash.cloudflare.com → R2
# Needed: as soon as we wire any feature that uploads or serves
# media. The free tier (10 GB / 1M writes / 10M reads per month)
# covers v1 dev and beta.
# See `docs/architecture.md` § Storage layer for the rationale.
# -------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omnigrowth-media-dev

# Public URL prefix for objects. Cloudflare gives you a default
# `<bucket>.<account-hash>.r2.dev` URL, or you can bind a custom
# domain (e.g. https://media.omnigrowth.app). No trailing slash.
R2_PUBLIC_URL=

# S3 endpoint Cloudflare exposes. Replace <account-id> after sign-up.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com


# -------------------------------------------------------------
# Context7 — paid library docs API (used by the project-scope MCP
# server defined in `.mcp.json`). Replaces the free / rate-limited
# Context7 plugin we removed.
# https://context7.com/dashboard → API keys
# Needed: only inside Claude Code sessions (it powers
# resolve-library-id and get-library-docs tool calls). Not read
# by Next.js or Convex at runtime.
#
# IMPORTANT: Claude Code does NOT auto-load `.env.local`. The var
# must be in the shell environment when you launch `claude`. The
# easiest pattern from this project root:
#
#     set -a; source .env.local; set +a; claude
#
# Or add this one line to your zshrc / bashrc to auto-export:
#     export CONTEXT7_API_KEY="ctx7..."
# -------------------------------------------------------------
CONTEXT7_API_KEY=


# -------------------------------------------------------------
# Coda — project management (running task list lives here)
# https://coda.io/account → API
# Needed: only if/when the app or Convex calls Coda's REST API
# directly. The Claude Code MCP server at https://coda.io/apis/mcp
# uses its own OAuth flow and does NOT read this token.
# -------------------------------------------------------------
CODA_API_TOKEN=


# -------------------------------------------------------------
# Coolify — render worker only (Remotion + ffmpeg, CPU)
# Your self-hosted Coolify instance on Hetzner. The worker
# subscribes to Convex jobs and writes finished assets to R2 above.
# No asset storage on this box anymore — see Storage layer.
# Needed: deferred. Only when `video-pipeline` ships.
# -------------------------------------------------------------
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_RENDER_WEBHOOK_SECRET=


# -------------------------------------------------------------
# App-level
# -------------------------------------------------------------

# Public origin used for OAuth callbacks and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public env tag — drives the `dev_` prefix on render jobs and the
# bucket suffix (omnigrowth-media-<env>), and toggles dev-only UI
# affordances. One of: dev, staging, prod.
NEXT_PUBLIC_APP_ENV=dev
